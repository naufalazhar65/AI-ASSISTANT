# Free provider: Groq (https://console.groq.com/keys — no credit card needed)
# Server-side only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional: route the LLM through a different, OpenAI-compatible endpoint
# (e.g. a 9router/proxy). When LLM_API_BASE is set, LLM_API_KEY + LLM_MODEL are
# used for the LLM; TTS always stays on Groq (GROQ_API_KEY).
#
# The LLM provider is selectable from the Settings UI (invariant 5: endpoints and
# keys never reach the client — the server maps ids to env below):
#   - "groq"      -> GROQ_API_KEY (+ GROQ_LLM_MODEL default)
#   - "opencode"  -> local `opencode serve` agent (native session/prompt_async API)
#   - "9router"   -> LLM_API_BASE / LLM_API_KEY / LLM_MODEL
#   - "openrouter" -> OPENROUTER_API_KEY (openrouter.ai, many free+paid models)
# The 9router/groq base entries below mirror that same mapping for direct use.
# LLM_API_BASE=https://api.9router.ai/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=
# GROQ_LLM_MODEL=qwen/qwen3.8-27b
#
# ── Speech-to-text (POST /api/stt) ───────────────────────────────────────────
# STT_PROVIDER=groq   # "groq" | "9router". groq = Whisper (whisper-large-v3-turbo,
#                     # best quality). 9router = Gemini audioInput via the
#                     # OpenAI-compatible router (LLM_API_BASE + LLM_API_KEY),
#                     # accepts webm/wav/mp3/ogg, zero Groq quota.
# STT_9ROUTER_MODEL=gemini/gemini-3.5-flash-lite
#
# Native OpenCode: the server must be running locally ("opencode serve", default
# http://127.0.0.1:4096) and its REST/SSE API is unauthenticated. Optional:
# OPENCODE_SERVER_BASE=http://127.0.0.1:4096
# OPENCODE_PROVIDER=
# OPENCODE_MODEL=

# OpenRouter (openrouter.ai): OpenAI-compatible gateway routing to many
# providers. Requires an API key from https://openrouter.ai/keys (free tier
# available). Optional overrides:
#OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# ── Telegram channel (Fase 2) ─────────────────────────────────────────────
# Long-polling bot started in-process via instrumentation.ts (single process).
# TELEGRAM_BOT_TOKEN is required; the bot only serves an allow-listed owner.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOWED_USER_ID=            # numeric telegram user id (or comma list)
#TELEGRAM_ALLOWED_USERNAME=           # telegram username WITHOUT @ (or comma list)
#TELEGRAM_CHAT_ID=                    # chat id to push proactive reminders to
#TELEGRAM_PROVIDER=groq               # default AI provider for the bot
#TELEGRAM_USER=naufal                 # persona/memory user key fallback
#TELEGRAM_VOICE_REPLY=1               # 0 to disable spoken (audio) replies on Telegram
#BOT_VOICE_REPLY=1                    # global switch; voice reply = WAV audio via Groq TTS,
                                      # falls back to text on quota/5xx (Orpheus = EN + Arabic,
                                      # Indonesian is read with English pronunciation)

# ── Discord channel (Fase 2.3) ─────────────────────────────────────────────
# Gateway bot started in-process via instrumentation.ts (single process).
# DISCORD_BOT_TOKEN is required; the bot only serves an allow-listed owner.
#DISCORD_BOT_TOKEN=
#DISCORD_ALLOWED_USER_ID=             # owner discord user id (snowflake string, or comma list)
#DISCORD_ALLOWED_CHANNEL_ID=          # optional: only serve this channel id (or comma list)
#DISCORD_PROVIDER=groq                # default AI provider for the bot
#DISCORD_VOICE_REPLY=1                # 0 to disable spoken (audio) replies on Discord
                                      # (bot must have permission to attach files)
#DISCORD_USER=naufal                  # persona/memory user key fallback

# Additional project workspaces the agent may read/exec into (beyond the repo
# root). Comma-separated absolute paths. Only listed dirs are ever accessible.
#ALLOWED_WORKSPACES=/Users/me/PROJECT/QA-WORKSPACE/flowtest-studio,/Users/me/PROJECT/other-app

# Heartbeat — periodic agent check-in for overdue/due-soon tasks. Interval in
# minutes (default 30). Set 0 to disable.
#HEARTBEAT_INTERVAL_MINUTES=30

# Evening recap — deterministic daily recap from memory + moods, auto-pushed to
# the owner's active channel. Hour (0-23, Asia/Jakarta local), default 21 (21:00).
# Set 0 to disable.
#RECAP_HOUR=21

# Fase 5 guardrails:
# Config management — env (priority) OR a per-deploy JSON file at
# .data/config.json using the same keys, OR built-in defaults. Example file:
#   { "RATE_LIMIT_TURNS_PER_MIN": 5, "TOOLS_DENY": "exec,write_file" }
# Rate limit — assistant turns per user per minute (0 = unlimited, default 30).
# App-level throttle BEFORE hitting the LLM provider (complements 429 handling).
#RATE_LIMIT_TURNS_PER_MIN=30
# Audit log — append-only per-day tool/turn trail at .data/audit/AUDIT-*.log.
# Set 0 to disable (default 1). AUDIT_KEEP_DAYS controls pruning (default 7).
#AUDIT_ENABLED=1
#AUDIT_KEEP_DAYS=7
# Operational log — append-only per-day lifecycle events at .data/logs/APP-*.log
# (bot start, heartbeat, recap, errors). Default on; keep days default 14.
#APP_LOG_ENABLED=1
#APP_LOG_KEEP_DAYS=14
# Web auth — when set, the web app + /api/* require this PIN (or an
# Authorization: Bearer header). Leave EMPTY for the default open personal-LAN
# deploy. Bots are unaffected (they call the shared core directly).
#AUTH_TOKEN=
# Permission policy — comma-separated tools to disable for every channel
# (blocked in executeTool before dispatch; still audited as tool:<x>::denied).
#TOOLS_DENY=
# Webhook — external trigger for automation (POST /api/webhook). If set, the
# request must include the same secret. Leave empty to allow without secret (not recommended for public deploys).
#WEBHOOK_SECRET=change-me
#WEBHOOK_USER=naufal
#WEBHOOK_PROVIDER=groq

# Default AI provider when a request/channel doesn't specify one ("groq" if unset).
# Only set this if you have the matching API key/env configured (e.g. LLM_API_KEY for 9router).
#DEFAULT_AI_PROVIDER=9router
#NEXT_PUBLIC_DEFAULT_AI_PROVIDER=9router   # client-side default shown in the web Settings UI

# Provider used by the web UI: "mock" (default, no key) or "groq" (real voice).
NEXT_PUBLIC_AI_PROVIDER=mock

# Orpheus TTS voice (autumn, diana, hannah, austin, daniel, troy) — English only.
GROQ_VOICE=hannah

# Optional: default voice for auto-detected Arabic (Saudi) sentences. When the
# AI replies in Arabic script, /api/tts uses the Saudi Arabic Orpheus model and
# this voice (abdullah, fahad, sultan, lulwa, noura, aisha). Defaults to lulwa.
# GROQ_VOICE_AR=lulwa

# ── Spotify integration (music playback control) ─────────────────────────────
# OAuth app from https://developer.spotify.com/dashboard/applications
# (redirect URI registered there must match SPOTIFY_REDIRECT_URI exactly).
# Server-side only — never prefix with NEXT_PUBLIC_. Playback control requires
# a Spotify Premium account (search/status work on free).
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback