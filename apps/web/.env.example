# Free provider: Groq (https://console.groq.com/keys — no credit card needed)
# Server-side only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional: route the LLM through a different, OpenAI-compatible endpoint
# (e.g. a 9router/proxy). When LLM_API_BASE is set, LLM_API_KEY + LLM_MODEL are
# used for the LLM; TTS always stays on Groq (GROQ_API_KEY).
#
# The LLM provider is selectable from the Settings UI (invariant 5: endpoints and
# keys never reach the client — the server maps ids to env below):
#   - "groq"      -> GROQ_API_KEY (+ GROQ_LLM_MODEL default)
#   - "opencode"  -> local `opencode serve` agent (native session/prompt_async API)
#   - "opencodego" -> OpenCode Go subscription gateway ($10/mo; OpenAI-compatible,
#                     https://opencode.ai/zen/go/v1/chat/completions).
#                     OPENCODEGO_API_KEY (or the opencode CLI login in
#                     ~/.local/share/opencode/auth.json slot "opencode-go").
#                     OPENCODEGO_MODEL default glm-5.2 (chat/completions models
#                     only: glm-5.1, grok-4.5, kimi-k3, deepseek-v4-*, mimo-*).
#   - "9router"   -> LLM_API_BASE / LLM_API_KEY / LLM_MODEL
#   - "openrouter" -> OPENROUTER_API_KEY (openrouter.ai, many free+paid models)
# OPENCODEGO_API_KEY=
# OPENCODEGO_MODEL=deepseek-v4.1-flash   # default brain model when "Auto"; e.g. glm-5.2 | deepseek-v4.1-flash | glm-5.3-flash
#
# ── Auto-Update Mia (mandiri, no .openclaw/Clawdbot) ─────────────────────────
# Daily self-update: git pull --ff-only -> npm install -> gates (typecheck/test/
# verify) -> summary push to owner (Telegram/Discord) -> optional server restart.
# AUTO_UPDATE_ENABLED=1          # 0 turns the whole feature off
# AUTO_UPDATE_HOUR=4             # run time (wall clock), Asia/Jakarta (0-23)
# AUTO_UPDATE_GRACE_MIN=120      # window after the hour to still run it once/day
# AUTO_UPDATE_TICK_MIN=5         # scheduler check interval (0 = manual/tool only)
# AUTO_UPDATE_REMOTE=origin      # git remote to pull
# AUTO_UPDATE_BRANCH=main        # branch to fast-forward
# AUTO_UPDATE_NPM=1              # run npm install when new commits came in
# AUTO_UPDATE_VERIFY=1           # also run verify.ts among the gates
# AUTO_UPDATE_RESTART=1          # respawn the dev server after a successful update
# AUTO_UPDATE_DELIVER=1          # push the summary via pushToOwner
# AUTO_UPDATE_TIMEOUT_MS=600000  # per-command timeout
#
# ── Weekly insight push (Mia) ────────────────────────────────────────────────
# Once-a-week digest of moods/tasks/conversation themes, pushed to the owner.
# 0 disables the automatic push (the weekly_insight tool still works).
# WEEKLY_INSIGHT_HOUR=20   # hour of day, Asia/Jakarta
# WEEKLY_INSIGHT_DAY=0     # 0=Sunday .. 6=Saturday
# The 9router/groq base entries below mirror that same mapping for direct use.
# LLM_API_BASE=https://api.9router.ai/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=
# GROQ_LLM_MODEL=qwen/qwen3.8-27b
#
# ── Advanced memory (semantic retrieval) ─────────────────────────────────────
# search_memory + auto-recall combine BM25 with embeddings. Endpoint defaults to
# LLM_API_BASE's base (e.g. the 9router proxy) unless EMBED_API_BASE is set.
# EMBED_API_BASE=
# EMBED_MODEL=gemini/gemini-embedding-001
# MEMORY_SEMANTIC_WEIGHT=0.6        # 0 = pure BM25, 1 = pure embedding
# MEMORY_RECALL_MIN_COS=0.28        # auto-recall cosine threshold
#
# ── Speech-to-text (POST /api/stt) ───────────────────────────────────────────
# STT_PROVIDER=groq   # "groq" | "9router". groq = Whisper (whisper-large-v3-turbo,
#                     # best quality). 9router = Gemini audioInput via the
#                     # OpenAI-compatible router (LLM_API_BASE + LLM_API_KEY),
#                     # accepts webm/wav/mp3/ogg, zero Groq quota.
# STT_9ROUTER_MODEL=gemini/gemini-3.5-flash-lite
#
# Native OpenCode: the server must be running locally ("opencode serve", default
# http://127.0.0.1:4096) and its REST/SSE API is unauthenticated. Optional:
# OPENCODE_SERVER_BASE=http://127.0.0.1:4096
# OPENCODE_PROVIDER=
# OPENCODE_MODEL=

# OpenRouter (openrouter.ai): OpenAI-compatible gateway routing to many
# providers. Requires an API key from https://openrouter.ai/keys (free tier
# available). Optional overrides:
#OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# ── Native message reactions (Discord + Telegram) ─────────────────────────
# Deterministic, zero-LLM: ack on task asks, contextual emoji on chat,
# ✅/⚠️ on real turn outcomes. Only the responding agent reacts, once per
# message (routed_agent_only). Reaction failures never touch the turn.
# --- Proactive workflows (scheduler) ---
#WORKFLOW_TICK_MS=60000             # how often the scheduler looks for due workflows (min 15s)
#WORKFLOW_PROVIDER=                 # provider for scheduled runs (default = DEFAULT_AI_PROVIDER)
#WORKFLOW_TZ=Asia/Jakarta           # default timezone for new workflows

#REACTIONS_ENABLED=1
#REACTIONS_DISCORD=1
#REACTIONS_TELEGRAM=1
#REACTIONS_MODE=routed_agent_only       # or participating_agents / all_agents
#REACTIONS_AGENTS=mia,agnes,michelle    # which agents may react
#REACTIONS_DELAY_MS=3000                # human-like pause before the first reaction lands
#REACTIONS_FALLBACK_COOLDOWN_MS=20000   # min gap between light fallback reactions per agent+chat (0 = off)

# ── Telegram channel (Fase 2) ─────────────────────────────────────────────
# Long-polling bot started in-process via instrumentation.ts (single process).
# TELEGRAM_BOT_TOKEN is required; the bot only serves an allow-listed owner.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOWED_USER_ID=            # numeric telegram user id (or comma list)
#TELEGRAM_ALLOWED_USERNAME=           # telegram username WITHOUT @ (or comma list)
#TELEGRAM_CHAT_ID=                    # chat id to push proactive reminders to
#TELEGRAM_PROVIDER=groq               # default AI provider for the bot
#TELEGRAM_USER=naufal                 # persona/memory user key fallback
#TELEGRAM_VOICE_REPLY=1               # 0 to disable spoken (audio) replies on Telegram
#BOT_VOICE_REPLY=1                    # global switch; voice reply = WAV audio via Groq TTS,
                                      # falls back to text on quota/5xx (Orpheus = EN + Arabic,
                                      # Indonesian is read with English pronunciation)

# ── Discord channel (Fase 2.3) ─────────────────────────────────────────────
# Gateway bot started in-process via instrumentation.ts (single process).
# DISCORD_BOT_TOKEN is required; the bot only serves an allow-listed owner.
#DISCORD_BOT_TOKEN=
#DISCORD_ALLOWED_USER_ID=             # owner discord user id (snowflake string, or comma list)
#DISCORD_ALLOWED_CHANNEL_ID=          # optional: only serve this channel id (or comma list)
#DISCORD_PROVIDER=groq                # default AI provider for the bot
#DISCORD_VOICE_REPLY=1                # 0 to disable spoken (audio) replies on Discord
                                      # (bot must have permission to attach files)
#
# --- Discord VOICE CHANNEL (live duplex conversation, owner 2026-10-06) ---
# In the text channel the owner types `!voice on [name]`, and the NAMED bot joins
# the voice channel below and talks back through Gemini Live. Requires the
# packages `@discordjs/voice sodium @discordjs/opus` and an `ffmpeg` binary on PATH.
#DISCORD_VOICE_CHANNEL_ID=            # voice channel id to join (snowflake)
#DISCORD_VOICE_HOST=mia               # which bot parses `!voice` (one parser, or 3 sessions open)
#APP_BASE_URL=http://127.0.0.1:3000   # server-side base for the Live token/tool routes
#
# Per-agent Gemini Live voices (distinct feminine registers; Mia unchanged):
#GEMINI_LIVE_VOICE=Leda               # Mia
#GEMINI_LIVE_VOICE_AGNES=Kore         # Agnes — level, considered
#GEMINI_LIVE_VOICE_MICHELLE=Aoede     # Michelle — quick, upbeat
#DISCORD_USER=naufal                  # persona/memory user key fallback
# ── Discord trio (Fase 4: Agnes + Michelle) ───────────────────────────────
# One Next process can host up to three bots. Agnes/Michelle reply only when
# mentioned, DM'd, or in their dedicated channel (never triple-reply). Each
# agent runs under a suffixed user key (owner.agnes / owner.michelle) so
# memory/persona never bleed across agents. NEVER paste real tokens in chat —
# put them here in apps/web/.env.local (git-ignored).
#DISCORD_BOT_TOKEN_AGNES=
#DISCORD_BOT_TOKEN_MICHELLE=
#DISCORD_CHANNEL_ID_MIA=            # optional per-agent dedicated channel
#DISCORD_CHANNEL_ID_AGNES=          # (replies there without needing a mention)
#DISCORD_CHANNEL_ID_MICHELLE=
# NOTE: the first configured id above is also where PROACTIVE pushes go —
# reminders, heartbeat, briefing, recap, automation and webhook results all
# prefer this channel, then the owner's last-seen channel, then their DM.
# Unset them all and pushes fall back to last-seen/DM as before.
#DISCORD_PROVIDER_AGNES=            # optional per-agent provider override
#DISCORD_PROVIDER_MICHELLE=         # (falls back to DISCORD_PROVIDER)

# ── Slack (Socket Mode) — trio, text-only ──────────────────────────────────
# One Slack APP per agent (Slack has no multi-bot-token app), Socket Mode so
# Slack dials US: no public URL, no ngrok. Setup per app, at api.slack.com/apps:
#   1. Socket Mode: ON  -> copy the App-Level Token (xapp-..., needs
#      connections:write)
#   2. OAuth & Permissions: app_mentions:read, chat:write, im:history, im:read,
#      channels:history, commands
#   3. Install to workspace -> copy the Bot Token (xoxb-...)
#   4. Event Subscriptions -> bot events: app_mention, message.im, message.channels
#   5. /invite @<bot> in the channel you want it in
# Unlike Discord, Slack trio bots CAN read each other (that is the point) —
# lib/slackTurnGuard bounds that: a sibling may be answered ONCE per thread,
# self-echo is refused, and at most 3 bot replies per owner turn.
# NEVER paste real tokens in chat — put them here in apps/web/.env.local.
#SLACK_BOT_TOKEN=                   # xoxb-...  (Mia, required for slack at all)
#SLACK_APP_TOKEN=                   # xapp-...  (Mia, required for socket mode)
#SLACK_BOT_TOKEN_AGNES=
#SLACK_APP_TOKEN_AGNES=
#SLACK_BOT_TOKEN_MICHELLE=
#SLACK_APP_TOKEN_MICHELLE=
#SLACK_ALLOWED_USER_ID=             # owner slack user id (U..., or comma list)
#SLACK_ALLOWED_CHANNEL_ID=          # optional: only serve these channels
#SLACK_CHANNEL_ID_MIA=              # optional per-agent dedicated channel
#SLACK_CHANNEL_ID_AGNES=
#SLACK_CHANNEL_ID_MICHELLE=
#SLACK_PUSH_CHANNEL_ID=             # where reminder/scheduled pushes go (else last seen)
#SLACK_PROVIDER=9router             # default AI provider for the bot
#SLACK_USER=naufal                  # persona/memory user key fallback
#SLACK_PROVIDER_AGNES=              # optional per-agent provider override
#SLACK_PROVIDER_MICHELLE=

# Additional project workspaces the agent may read/exec into (beyond the repo
# root). Comma-separated absolute paths. Only listed dirs are ever accessible.
#ALLOWED_WORKSPACES=/Users/me/PROJECT/QA-WORKSPACE/flowtest-studio,/Users/me/PROJECT/other-app
#WRITE_ANYWHERE=1                      # write_file/file_edit may target ANY absolute path (reads + exec stay sandboxed); 0 = sandbox only

# Heartbeat — periodic agent check-in for overdue/due-soon tasks. Interval in
# minutes (default 30). Set 0 to disable.
#HEARTBEAT_INTERVAL_MINUTES=30

# OAST auto-watcher — polls active webhook.site callback tokens for NEW hits,
# attributes them to the outgoing probe (http-history) and pushes one
# notification to the owner. Interval in minutes (default 5). Set 0 to disable.
#OAST_WATCH_MIN=5

# Evening recap — deterministic daily recap from memory + moods, auto-pushed to
# the owner's active channel. Hour (0-23, Asia/Jakarta local), default 21 (21:00).
# Set 0 to disable.
#RECAP_HOUR=21

# Proactive assistant — Mia speaks first: a caring check-in when yesterday's
# mood was negative (stressed/sad/tired/...). Once per day, deduped, silent when
# nothing to say. PROACTIVE_HOUR_START/END = waking window (Asia/Jakarta).
#PROACTIVE_ENABLED=1
#PROACTIVE_HOUR_START=8
#PROACTIVE_HOUR_END=22

# Context awareness — samples the active app/window on the Mac (privacy-safe:
# names only) so the user can ask "lagi ngapain". Seconds between samples
# (default 15). Set 0 to disable (tool then samples on demand when called).
#CONTEXT_SAMPLE_SECONDS=15

# Morning briefing — at BRIEFING_HOUR (Asia/Jakarta, default 7) Mia pushes a
# short warm digest: tasks due today + overdue, today's reminders, yesterday's
# mood+memory, and any civil holiday today. Deterministic, silent when nothing
# to report. A "briefing" tool serves it on demand in chat too.
#BRIEFING_ENABLED=1
#BRIEFING_HOUR=7

# Rolling conversation summary — when a chat's total text exceeds
# ROLLING_SUMMARY_TRIGGER_CHARS (default 24000), the OLDEST messages are rolled
# into one short "previous conversation" summary via one LLM call (cached per
# boundary: disk per-user + in-memory by hash). The last
# ROLLING_SUMMARY_KEEP_RECENT messages stay verbatim. Offline/mock/no-provider
# falls back to a deterministic digest — never fatal.
#ROLLING_SUMMARY_ENABLED=1
#ROLLING_SUMMARY_TRIGGER_CHARS=24000
#ROLLING_SUMMARY_KEEP_RECENT=8

# Fase 5 guardrails:
# Config management — env (priority) OR a per-deploy JSON file at
# .data/config.json using the same keys, OR built-in defaults. Example file:
#   { "RATE_LIMIT_TURNS_PER_MIN": 5, "TOOLS_DENY": "exec,write_file" }
# Rate limit — assistant turns per user per minute (0 = unlimited, default 30).
# App-level throttle BEFORE hitting the LLM provider (complements 429 handling).
#RATE_LIMIT_TURNS_PER_MIN=30
# Audit log — append-only per-day tool/turn trail at .data/audit/AUDIT-*.log.
# Set 0 to disable (default 1). AUDIT_KEEP_DAYS controls pruning (default 7).
#AUDIT_ENABLED=1
#AUDIT_KEEP_DAYS=7
# Operational log — append-only per-day lifecycle events at .data/logs/APP-*.log
# (bot start, heartbeat, recap, errors). Default on; keep days default 14.
#APP_LOG_ENABLED=1
#APP_LOG_KEEP_DAYS=14
# Web auth — when set, the web app + /api/* require this PIN (or an
# Authorization: Bearer header). Leave EMPTY for the default open personal-LAN
# deploy. Bots are unaffected (they call the shared core directly).
#AUTH_TOKEN=
# Permission policy — comma-separated tools to disable for every channel
# (blocked in executeTool before dispatch; still audited as tool:<x>::denied).
#TOOLS_DENY=
# Webhook — external trigger for automation (POST /api/webhook). If set, the
# request must include the same secret. Leave empty to allow without secret (not recommended for public deploys).
#WEBHOOK_SECRET=change-me
#WEBHOOK_USER=naufal
#WEBHOOK_PROVIDER=groq

# Default AI provider when a request/channel doesn't specify one ("groq" if unset).
# Only set this if you have the matching API key/env configured (e.g. LLM_API_KEY for 9router).
#DEFAULT_AI_PROVIDER=9router
#NEXT_PUBLIC_DEFAULT_AI_PROVIDER=9router   # client-side default shown in the web Settings UI

# Provider used by the web UI: "mock" (default, no key) or "groq" (real voice).
NEXT_PUBLIC_AI_PROVIDER=mock

# Orpheus TTS voice (autumn, diana, hannah, austin, daniel, troy) — English only.
GROQ_VOICE=hannah

# Optional: default voice for auto-detected Arabic (Saudi) sentences. When the
# AI replies in Arabic script, /api/tts uses the Saudi Arabic Orpheus model and
# this voice (abdullah, fahad, sultan, lulwa, noura, aisha). Defaults to lulwa.
# GROQ_VOICE_AR=lulwa

# ── TTS provider ─────────────────────────────────────────────────────────
# groq (default, Orpheus EN+AR) or elevenlabs (multilingual, ID natural)
#TTS_PROVIDER=groq
#ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Gmail inbox (read-only) ───────────────────────────────────────────────
# OAuth app from https://console.cloud.google.com/apis/credentials
# Enable Gmail API, create OAuth 2.0 Client ID (Web), add redirect URI:
# http://localhost:3000/api/gmail/callback (and prod URL).
# Server-side only — never prefix with NEXT_PUBLIC_.
#GMAIL_CLIENT_ID=
#GMAIL_CLIENT_SECRET=
#GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ── Spotify integration (music playback control) ─────────────────────────────
# OAuth app from https://developer.spotify.com/dashboard/applications
# (redirect URI registered there must match SPOTIFY_REDIRECT_URI exactly).
# Server-side only — never prefix with NEXT_PUBLIC_. Playback control requires
# a Spotify Premium account (search/status work on free).
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
# Force spotify_play through the local macOS app (AppleScript) instead of the
# Web API play endpoint — a test toggle for verifying the osascript route.
#SPOTIFY_FORCE_LOCAL=1
# --- Security / pentest (optional) ---
# Extra hosts Mia may actively scan (own/authorized only, comma-separated).
# Own labs you are authorized to test (comma-separated hosts; a bare domain also
# covers its real subdomains). Needed for a PUBLIC owned lab (e.g. a Netlify
# practice site) — localhost/RFC1918 is allowed without it. Example:
# PENTEST_LAB_TARGETS=my-lab.internal,10.0.0.5,cozy-kangaroo-42f2e0.netlify.app
# NB: Netlify *deploy preview* hosts are `<deploy-id>--<site>.netlify.app`, which
# is NOT a subdomain of `<site>.netlify.app` — list the preview host explicitly.
# Domains to watch for TLS cert expiry via the heartbeat (comma-separated).
# SECURITY_CERT_DOMAINS=example.com,app.example.com
# Warn when a watched cert expires within N days (default 14).
# SECURITY_CERT_DAYS=14

# Zona waktu user — dipakai system prompt (currentTimeLine) dan reminder variants.
# Dipin ke Asia/Jakarta supaya jam user TIDAK ikut zona server (live 2026-10-13:
# variant reminder jam 18:59 ditulis "makan siang" karena model tak diberi waktu).
MIA_USER_TIMEZONE=Asia/Jakarta

# Autonomous problem-solving loop (apps/web/src/lib/recovery) — hard budgets.
# Every value is a stop condition, not a suggestion: 3 identical attempts = stop,
# approval/scope failures are escalated, never re-tried by the loop.
# RECOVERY_MAX_ATTEMPTS is capped by the plan budget: the effective cap is
# min(RECOVERY_MAX_ATTEMPTS, ORCHESTRATION_MAX_RETRIES + 1) — with the default
# retry budget that is 2 attempts total, and no env value can loosen the plan.
# RECOVERY_MAX_TOOL_CALLS counts the tool calls subtask turns actually executed.
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_MAX_SAME_CLASS=2
RECOVERY_MAX_IDENTICAL=3
RECOVERY_MAX_SUBTASKS=2
RECOVERY_MAX_DELEGATION_DEPTH=2
RECOVERY_MAX_TOOL_CALLS=24
RECOVERY_MAX_WALL_CLOCK_MS=600000
RECOVERY_BACKOFF_MS=0

# ── Office dashboard (apps/office-dashboard/server.js) ─────────────────────
# The dashboard is its own process: it serves the UI on 127.0.0.1:3001 and
# dispatches work to the Mia app. It authenticates with DASHBOARD_TOKEN, or
# with AUTH_TOKEN from the Mia app when DASHBOARD_TOKEN is unset.
# DASHBOARD_TOKEN=
# Where the dashboard calls the Mia app (default: the local Next server).
# MIA_LLM_URL=http://127.0.0.1:3000/api/llm
# MIA_WEB_BASE=http://127.0.0.1:3000
# MIA_WEBHOOK_URL=http://127.0.0.1:3000/api/webhook
# The label used when the dashboard delivers a result to a channel.
# OFFICE_DELIVERY_LABEL=office
# The owner whose sessions the dashboard reads (per-user isolation).
# OFFICE_OWNER_USER=naufalazhar652952
# How long a dispatch may run before it is abandoned (ms).
# OFFICE_DISPATCH_TIMEOUT_MS=180000
# The window in which the office counts itself as "working" (ms).
# OFFICE_WORKING_WINDOW_MS=120000
# Folders with .md schedules the dashboard picks up (comma-separated).
# OFFICE_SCHEDULE_DIRS=
# Base URL of the dashboard, used by the furniture probe and the UI drill.
# OFFICE_BASE=http://127.0.0.1:3001
# OFFICE_DASH_URL=http://127.0.0.1:3001

# ── Chrome DevTools Protocol (authenticated app testing) ────────────────────
# Port of the Chrome instance Mia drives (scripts/chrome-debug.sh). It must
# run with --remote-debugging-port; Chrome 136+ refuses the default profile.
# CDP_PORT=9222
# CDP_TIMEOUT_MS=30000

# ── Local device pairing (device_list / device_exec) ──────────────────────
# Shared secret for paired devices. Without it a local device is created
# automatically, but remote pairing stays off.
# DEVICE_SECRET=

# ── Gemini Live (voice, apps/web/src/app/api/gemini-live/token) ────────────
# Key for the Live voice session. Without it the Live route refuses to issue
# a token. Server-side only.
# GEMINI_API_KEY=

# ── Local text-to-speech (macOS `say`, Indonesian voice) ───────────────────
# Indonesian has no Groq Orpheus model, so it is spoken by the local macOS
# voice instead. TTS_LOCAL_ID=0 turns the local path off entirely.
# TTS_LOCAL_ID=1
# TTS_ID_VOICE=Damayanti
# Local Whisper binary for STT (falls back to Groq when absent).
# WHISPER_BIN=whisper

# ── Safe exec (guarded shell writes) ───────────────────────────────────────
# SAFE_EXEC_DISABLE=1     # refuse every guarded shell write
# SAFE_EXEC_AUTO_CONFIRM=1  # auto-approve the allow-listed safe commands
# OPENCLAW_AGENT_CALL=1   # set while Mia itself runs the command
# AUDIT_* and APP_LOG_* control the audit trail (see below).

# ── Security scope (active testing) ─────────────────────────────────────────
# SECURITY_REQUEST_DELAY_MS=150   # polite delay between requests
# SECURITY_SCOPE_WATCH=          # hosts to watch for new subdomains
# AUTO_UPDATE_ENABLED=1 is documented above; automation runs on its own clock.
# AUTOMATION_PROVIDER=            # provider id used for scheduled automations
# WIND_DOWN_HOUR=21               # wind-down reminder (local hour)

# ── OpenCode native provider (local `opencode serve`) ──────────────────────
# Only used when the provider id is "opencode". The defaults point at the
# local 9router proxy; OPENCODE_LLM_KEY may stay EMPTY.
# OPENCODE_LLM_BASE=http://localhost:20128/v1/chat/completions
# OPENCODE_LLM_KEY=EMPTY
# OPENCODE_LLM_MODEL=open-code
# OPENCODE_TURN_TIMEOUT_MS=60000
# OPENCODE_DEBUG=1                # verbose OpenCode adapter logging

# ── OpenCode Go gateway (opencodego provider) ─────────────────────────────
# Overrides the gateway base (default: https://opencode.ai/zen/go/v1/chat/completions).
# OPENCODEGO_BASE_URL=

# ── Orchestration budget (multi-agent delegation) ──────────────────────────
# Hard stops for the planner: depth, task count, parallelism, retries, and
# the two time budgets (per task, whole run). Every value is a limit.
# ORCHESTRATION_MAX_DEPTH=2
# ORCHESTRATION_MAX_TASKS=8
# ORCHESTRATION_MAX_CONCURRENT=2
# ORCHESTRATION_MAX_RETRIES=1
# ORCHESTRATION_TASK_TIMEOUT_MS=120000
# ORCHESTRATION_MAX_DURATION_MS=600000

# ── Evaluation gates (npm run eval) ────────────────────────────────────────
# Per-category pass thresholds (percent). A category below its threshold
# fails the gate even when no case failed.
# EVAL_GATE_MIN_SAFETY=100
# EVAL_GATE_MIN_EVIDENCE=100
# EVAL_GATE_MIN_EXECUTION=100
# EVAL_GATE_MIN_CORRECTNESS=95
# EVAL_GATE_MIN_ROUTING=95
# EVAL_GATE_REQUIRE_EXECUTED=1    # a case only passes with a real execution
# EVAL_GATE_FAIL_ON_BLOCKED=1     # blocked cases count as failures
# EVAL_GATE_FAIL_ON_REGRESSION=1  # a case that used to pass must keep passing
# EVAL_MODEL_GRADE=1              # let the model layer grade its own answers
# EVAL_GRADER_MODEL=              # model used for grading (default: configured)
# EVAL_REGRESSION_ALLOW_MISSING_BASELINE=1  # allow a regression run without one

# ── Diagnostics ────────────────────────────────────────────────────────────
# MIA_GUARD_DEBUG=1        # log every honesty guard decision
